    <string name="settings_hook_enabled_title">启用总 Hook</string>
    <string name="settings_hook_enabled_summary">总逻辑开关。关闭后 Hook 仍正常注入，但冻结和性能调控相关逻辑都不执行。</string>
    <string name="settings_freeze_hook_enabled_title">启用冻结 Hook</string>
    <string name="settings_freeze_hook_enabled_summary">只控制冻结、解冻和冻结轮询判定。关闭后前台切换与亮灭屏等调控信号仍可继续工作。</string>
    <string name="settings_performance_hook_enabled_title">启用调控 Hook</string>
    <string name="settings_performance_hook_enabled_summary">控制前台切换、亮屏、熄屏等调控信号采集。关闭后冻结逻辑仍可单独运行。</string>
    <string name="settings_process_debug_log_title">启用进程调试日志</string>
    <string name="settings_process_debug_log_summary">控制 process-cmd / process-enter / process-perf 等调试日志，默认关闭。</string>
    <string name="settings_foreground_debug_log_title">启用前台进程调试日志</string>
    <string name="settings_foreground_debug_log_summary">控制 foreground recv、通知前台刷新、前台解析失败等日志，默认关闭，避免后台持续刷日志。</string>
    <string name="settings_notification_title">常驻通知</string>
    <string name="settings_notification_summary">在通知栏持续显示当前前台应用和估算功耗，便于后续关注。</string>
    <string name="settings_notification_toggle_title">启用常驻通知</string>
    <string name="settings_startup_title">自启动与守护</string>
    <string name="settings_startup_summary">daemon 始终会在开机和应用更新后自动恢复；这里只控制常驻通知和耗电记录是否也跟着恢复。</string>
    <string name="settings_auto_start_enabled_title">开机自启动</string>
    <string name="settings_auto_start_enabled_summary">启用后在开机、用户解锁和应用更新后自动恢复 Silence 的常驻通知和耗电记录。</string>
    <string name="settings_power_record_enabled_title">启用耗电记录</string>
    <string name="settings_power_record_enabled_summary">打开后按下面的轮询间隔写入性能记录文件，包含功耗、电量、前台包名和当前性能档位。</string>
    <string name="settings_power_record_poll_hint">耗电记录轮询时间（秒）</string>
    <string name="settings_external_mode_title">外部切换</string>
    <string name="settings_external_mode_summary">把当前性能挡位同步写入一个外部文件，用于接管外部的如 Uperf 的调度挡位，与 Silence 自带的调度功能冲突。</string>
    <string name="settings_external_mode_enabled_title">启用外部挡位写入</string>
    <string name="settings_external_mode_path_hint">外部挡位文件路径</string>
    <string name="settings_freeze_section_title">进程冻结</string>
    <string name="settings_freeze_section_summary">管理进程列表、冻结规则和状态判断。这里只影响进程冻结，不改变性能档位。</string>
    <string name="settings_performance_section_title">性能调控</string>
    <string name="settings_performance_section_summary">控制前台切换时的性能调控信号，以及是否交给外部调度器接管。</string>
    <string name="settings_monitoring_section_title">监控与记录</string>
    <string name="settings_monitoring_section_summary">常驻通知用于查看当前状态；功耗记录会按间隔写入历史文件。</string>
    <string name="settings_advanced_section_title">高级诊断</string>
    <string name="settings_advanced_section_summary">普通使用不需要修改。这里保留 Hook 总开关、调试日志和轮询参数。</string>
